# Copy to .env.deploy (never committed) or set these as build variables in Workers Builds.
# `npm run deploy` and `npm run db:migrate` turn wrangler.jsonc into wrangler.deploy.jsonc with them.
STEM_HOSTNAME=auth.example.com
STEM_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
EMAIL_FROM=stem <login@example.com>

# Optional.
# Extra team roles for your apps, comma separated.
ORG_ROLES=
# APIs that get JWT access tokens (RFC 8707 resource indicators), comma separated.
RESOURCES=
# Turnstile on "email me a code". Also set the TURNSTILE_SECRET secret.
TURNSTILE_SITE_KEY=
# Optional: apps that take mandates, as JSON (docs/mandates.md)
MANDATE_APPS=
