// stem: Cloudflare Workers config. A template: values written as <PLACEHOLDER> are filled from
// environment variables by scripts/render-config.mjs, which writes wrangler.deploy.jsonc (not committed).
// See README, "Self-hosting". Operator details and secrets never go in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stem",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Serve on your own (sub)domain. The zone must be on the same Cloudflare account.
  "routes": [{ "pattern": "<STEM_HOSTNAME>", "custom_domain": true }],
  // No workers.dev or preview URLs: an auth service must only answer on its issuer origin.
  "workers_dev": false,
  "preview_urls": false,

  // Keep variables set in the dashboard (LEGAL) across deploys.
  "keep_vars": true,
  "vars": {
    "STEM_URL": "https://<STEM_HOSTNAME>",
    "EMAIL_FROM": "<EMAIL_FROM>",
    // Extra organization roles for your apps, comma separated.
    "ORG_ROLES": "<ORG_ROLES?>",
    // APIs that get JWT access tokens (RFC 8707 resource indicators), comma separated.
    "RESOURCES": "<RESOURCES?>",
    // Turnstile on "email me a code" (also set the TURNSTILE_SECRET secret).
    "TURNSTILE_SITE_KEY": "<TURNSTILE_SITE_KEY?>",
    // Apps that take mandates, as JSON (docs/mandates.md). Empty turns mandates off.
    "MANDATE_APPS": "<MANDATE_APPS?>",
    // App pages that may fetch passes (anonymous quota tokens) for signed-in people, comma separated origins.
    "PASS_ORIGINS": "<PASS_ORIGINS?>",
    // Sealed apps (docs/sealed-apps.md), comma separated app ids. Needs the PAIRWISE_SECRET secret. Empty turns them off.
    "SEALED_APPS": "<SEALED_APPS?>",
    // "true" emails people whenever a passkey is added to their account. Empty turns it off.
    "NOTIFY_NEW_PASSKEY": "<NOTIFY_NEW_PASSKEY?>"
    // Optional: operator details for /imprint, /impressum, /privacy and /datenschutz (hidden when unset).
    // Set it in the dashboard or your deploy pipeline rather than committing it.
    // "LEGAL": "{\"name\":\"Jane Doe\",\"street\":\"Example St 1\",\"city\":\"12345 Town\",\"country\":{\"en\":\"Germany\",\"de\":\"Deutschland\"},\"email\":\"jane@example.com\",\"authority\":\"Your data protection authority, address\"}"
  },

  // Daily cleanup of expired sessions, codes, counters, tokens and invitations (src/cleanup.ts).
  "triggers": { "crons": ["23 3 * * *"] },

  // Static browser bundle (built by `npm run build:client`). The Worker runs first for every request.
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },

  "d1_databases": [{ "binding": "DB", "database_name": "stem-db", "database_id": "<STEM_D1_DATABASE_ID>", "migrations_dir": "migrations" }],

  // Cloudflare Email Sending. The domain of EMAIL_FROM must be onboarded to Email Service.
  "send_email": [{ "name": "EMAIL" }],

  // Mandates: one SQLite-backed Durable Object per root mandate (stop button, shared budget, trail).
  "durable_objects": { "bindings": [{ "name": "MANDATE", "class_name": "Mandate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mandate"] }],

  // Per IP and minute, on top of Better Auth's own per-endpoint limits (stored in D1).
  "ratelimits": [
    { "name": "AUTH_RL", "namespace_id": "2101", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_RL", "namespace_id": "2102", "simple": { "limit": 300, "period": 60 } }
  ]
  // Secrets (not in this file): BETTER_AUTH_SECRET, OPERATOR_TOKEN, TURNSTILE_SECRET
  // → `npx wrangler secret put BETTER_AUTH_SECRET`
}
