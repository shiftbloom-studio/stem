{
  "name": "stem",
  "version": "0.1.0",
  "description": "Sign-in for shiftbloom studio apps: passkeys, email codes, organizations and OpenID Connect on Cloudflare Workers",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiftbloom-studio/stem.git"
  },
  "homepage": "https://stem.shiftbloom.studio",
  "bugs": {
    "url": "https://github.com/shiftbloom-studio/stem/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "build:client": "esbuild src/client/app.ts --bundle --format=iife --minify --target=es2022 --outfile=public/assets/app.js",
    "build": "npm run build:client && wrangler deploy --dry-run --outdir=.wrangler/dry-run",
    "deploy": "npm run build:client && wrangler deploy",
    "typecheck": "tsc -p . && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "check": "npm run typecheck && vitest run && npm run build",
    "db:schema": "esbuild scripts/schema.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=.wrangler/schema.mjs && node .wrangler/schema.mjs",
    "db:migrate": "wrangler d1 migrations apply stem-db --remote"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.28",
    "@better-auth/passkey": "1.7.28",
    "better-auth": "1.7.28",
    "hono": "^4.13.22",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
